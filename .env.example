# Copy this file to .env and fill in the values. Never commit .env: it holds real passwords and keys.
# Values here are empty or safe defaults only.

# --- Local database (Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pagila

# Passwords for the three least-privilege database roles (created by db/init on first start)
READER_PASSWORD=
APP_USER_PASSWORD=
API_USER_PASSWORD=

# Where the services find the database (defaults suit local Docker)
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer          # Python service: "require" for hosted databases such as Neon
DB_SSL=false               # Express: "true" for hosted databases such as Neon

# --- LLM (any OpenAI-compatible provider) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# --- Express API ---
JWT_SECRET=                # at least 32 characters, e.g. the output of: openssl rand -hex 32
GEN_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
QUERY_RATE_LIMIT_PER_HOUR=20
TRUST_PROXY=0              # 1 behind a hosting provider's proxy (e.g. Render)
SERVE_WEB=false            # true in deployment: Express also serves the built React app

# --- Protection for a deployed generation service ---
INTERNAL_API_TOKEN=        # shared secret between Express and the generation service; empty = not required
DAILY_TOKEN_BUDGET=0       # stop answering after this many LLM tokens per day; 0 = no limit

# --- Answer cache (optional; empty disables it) ---
REDIS_URL=redis://localhost:6379/0

# --- Tracing (optional; leave the keys empty to turn it off) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com