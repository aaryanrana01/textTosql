POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pagila
READER_PASSWORD=change_me_too

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# POSTGRES_USER: Username of the PostgreSQL administrator
# POSTGRES_PASSWORD: Password for the administrator
# POSTGRES_DB: Name of the database to create	
# READER_PASSWORD: Password for a separate, read-only database user	
